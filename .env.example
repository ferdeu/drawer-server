# Copy this file to .env and fill it in. .env is gitignored: your secrets never reach the repo.
# The scripts read it automatically.

# Home router admin page (used to set the DHCP reservation and DNS)
ROUTER_URL=http://192.168.1.1
ROUTER_PASSWORD=

# NextDNS (scripts/06-nextdns.sh) - my.nextdns.io > Setup
NEXTDNS_PROFILE_ID=
# Setup > Linked IP > "Show advanced options": https://link-ip.nextdns.io/<profile>/<secret>
NEXTDNS_LINK_URL=

# Luanti game server (scripts/07-luanti.sh): this player name is the admin
LUANTI_ADMIN=

# Status panel (scripts/08-panel.sh): en or es
PANEL_LANG=
# Panel home cards: Starlink dish, Epson printer ink, who's home (Name=fixed-IP of their phone)
PANEL_STARLINK=
PANEL_PRINTER_IP=
PANEL_PEOPLE=
# Wi-Fi devices card: tplink reads every connected device from the router (uses ROUTER_URL/PASSWORD)
PANEL_ROUTER=
# names for devices that report none, by MAC: F4-70-18-00-00-01=Doorbell,02-52-5B-00-00-02=Server
PANEL_DEVICE_NAMES=

# Photo backup (scripts/09-syncthing.sh): password for the Syncthing control page, user "admin".
# Leave it empty and the script makes one up and saves it here.
SYNCTHING_GUI_PASSWORD=
