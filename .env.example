# Copy this file to .env and fill in what you use. .env is gitignored: your secrets never reach the repo.
# The scripts read it automatically. Steps 0-5 need nothing from here: leave it empty to start.
# Changed something later? Re-run that step's script (for the panel: bash scripts/08-panel.sh).
# Values with spaces go in double quotes: PANEL_TITLE="Our house". Without them every step fails to start.

# --- Step 6, ad blocking (optional; skipped while NEXTDNS_LINK_URL is empty) ---------------------
# Free account at my.nextdns.io. Profile ID: Setup page, for your own notes (the scripts don't use it).
NEXTDNS_PROFILE_ID=
# Setup > Linked IP > "Show advanced options": https://link-ip.nextdns.io/<profile>/<secret>
NEXTDNS_LINK_URL=

# --- Step 7, game server (optional; skipped while LUANTI_ADMIN is empty) -----------------------
# The player name that gets admin rights: letters, numbers, - or _ (20 at most)
LUANTI_ADMIN=
# true = creative: unlimited blocks, flying, no dying, no monsters (default false = survival).
# Players who already joined need "/grant <name> fly, fast" from the admin to fly. Re-run step 7 after changing it
LUANTI_CREATIVE=
# mineclonia (like Minecraft, the default) or minetest (Minetest Game: simpler, no monsters or animals).
# A world keeps its game: to switch games, also set a new LUANTI_WORLD
LUANTI_GAME=
# World folder on the phone (default casa); a new name starts a new world, the old one is kept
LUANTI_WORLD=

# --- Step 8, status panel (see docs/panel.md) ---------------------------------------------------
# en or es, and the name on top, in quotes: PANEL_TITLE="Our house" (default "Drawer server")
PANEL_LANG=
PANEL_TITLE=
# Home cards, each one optional: Starlink dish (yes), Epson printer ink (its fixed IP),
# who's home (Name=fixed-IP of their phone, comma-separated: Ana=192.168.1.20,Bo=192.168.1.21)
PANEL_STARLINK=
PANEL_PRINTER_IP=
PANEL_PEOPLE=
# Wi-Fi devices card: tplink reads every connected device from a TP-Link router
PANEL_ROUTER=
# names for devices that report none, by MAC: F4-70-18-00-00-01=Doorbell,02-52-5B-00-00-02=Server
# (easier: tap a device in the panel to name it; names given there win over these)
PANEL_DEVICE_NAMES=
# devices to leave out of the panel, by MAC, comma-separated (e.g. a camera's Wi-Fi you turned off
# because it's on cable: otherwise it shows as an offline camera for a month)
PANEL_DEVICE_HIDE=
# Speed test card: how many tests a day, 0 to 6 (0 = only the "Test again" button). Each test
# moves ~100 MB through your internet, so mind data caps. Empty = no speed test.
PANEL_SPEEDTEST=
# Recordings section in the panel (step 12): yes or no. Empty = shown.
PANEL_RECORDINGS=
# How the phone's storage is shared, in GB (numbers like 20 or 7.5). Empty = the default.
# Room for motion clips (default: 10% of the phone's storage):
DISK_RECORDINGS_GB=
# Most room the photo backup should use (default: no limit). Over 90% the panel warns; it never deletes photos:
DISK_BACKUP_GB=
# yes = pause the photo backup when it reaches DISK_BACKUP_GB, and resume it under 95% of it.
# It never deletes photos and doesn't affect recording (default: no):
DISK_BACKUP_PAUSE=
# Free space the recorder keeps, in GB (default 5, at least 1). Below it the recorder deletes its
# oldest clips first, and only when none are left does it stop making new ones:
DISK_KEEP_FREE_GB=
# Router admin page and password, only for PANEL_ROUTER=tplink (usually http://192.168.1.1)
ROUTER_URL=
ROUTER_PASSWORD=

# --- Step 9, photo backup (optional) --------------------------------------------------------------
# Password for the Syncthing control page, user "admin".
# Leave it empty and the script makes one up and adds it at the end of this file.
SYNCTHING_GUI_PASSWORD=

# --- Step 10, smart plug that charges between 30 and 80% (optional) ------------------------------
# From your iot.tuya.com cloud project (scripts/10-smart-plug.sh explains how to make one):
# Access ID, Access Secret and data center (us = Western America, eu, in, cn).
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=
# only if Smart Life has more than one device: the plug's name there
TUYA_PLUG_NAME=
# Charge window in %, default 30 and 80 (low at least 10, at least 10 apart).
# The panel does the switching: change these, then re-run step 8.
CHARGE_LOW=
CHARGE_HIGH=

# --- Step 11, cameras in the panel, home only (optional) -----------------------------------------
# One entry per camera, Name=IP:CODE, comma separated. Give each camera a fixed IP in the router.
# Ezviz / Hikvision: the code is the verification code on the camera's sticker.
#   PANEL_CAMERAS="Front=192.168.1.50:ABCDEF,Back=192.168.1.52:GHIJKL"
PANEL_CAMERAS=
# Other brands: RTSP user and paths (defaults: admin, /ch1/main/av_stream, /ch1/sub/av_stream).
CAMERA_USER=
CAMERA_MAIN_PATH=
CAMERA_SUB_PATH=

# --- Step 12, motion recording for the cameras (optional) ----------------------------------------
# yes = the phone watches the cameras and saves a short clip whenever something moves.
# It keeps the phone busy around the clock, so the phone runs warmer (see docs/path-a.md).
RECORDER=
# Which cameras to record, by the names in PANEL_CAMERAS, comma separated. Empty = all of them.
RECORD_CAMERAS=
# Seconds kept from before the movement started, 0 to 30 (default 5)
RECORD_BEFORE=
# Seconds recorded after the movement stops, 2 to 60 (default 10)
RECORD_AFTER=
# 1 (notices only big changes) to 10 (notices small ones), default 5
RECORD_SENSITIVITY=
# fast = checks often, light = checks less often and uses less CPU, so the phone runs cooler (default fast)
RECORD_CHECK=
# If a camera gets covered or blocked: keep = keep recording, pause = stop until it clears (default keep).
# If a camera sees a plant, a flag or anything that moves all the time, pause is the better choice.
RECORD_OBSTRUCTED=
