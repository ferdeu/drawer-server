# Copy this file to .env and fill it in. .env is gitignored: your secrets never reach the repo.
# The scripts read it automatically.

# Home router admin page (used to set the DHCP reservation and DNS)
ROUTER_URL=http://192.168.1.1
ROUTER_PASSWORD=

# NextDNS (scripts/06-nextdns.sh) - my.nextdns.io > Setup
NEXTDNS_PROFILE_ID=
# Setup > Linked IP > "Show advanced options": https://link-ip.nextdns.io/<profile>/<secret>
NEXTDNS_LINK_URL=
