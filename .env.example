# Copy this file to .env and fill in what you use. .env is gitignored: your secrets never reach the repo.
# The scripts read it automatically. Steps 0-5 need nothing from here: leave it empty to start.
# Changed something later? Re-run that step's script (for the panel: bash scripts/08-panel.sh).
# Values with spaces go in double quotes: PANEL_TITLE="Our house". Without them every step fails to start.

# --- Step 6, ad blocking (optional; skipped while NEXTDNS_LINK_URL is empty) ---------------------
# Free account at my.nextdns.io. Profile ID: Setup page, for your own notes (the scripts don't use it).
NEXTDNS_PROFILE_ID=
# Setup > Linked IP > "Show advanced options": https://link-ip.nextdns.io/<profile>/<secret>
NEXTDNS_LINK_URL=

# --- Step 7, game server (optional; skipped while LUANTI_ADMIN is empty) -----------------------
# The player name that gets admin rights: letters, numbers, - or _ (20 at most)
LUANTI_ADMIN=

# --- Step 8, status panel (see docs/panel.md) ---------------------------------------------------
# en or es, and the name on top, in quotes: PANEL_TITLE="Our house" (default "Drawer server")
PANEL_LANG=
PANEL_TITLE=
# Home cards, each one optional: Starlink dish (yes), Epson printer ink (its fixed IP),
# who's home (Name=fixed-IP of their phone, comma-separated: Ana=192.168.1.20,Bo=192.168.1.21)
PANEL_STARLINK=
PANEL_PRINTER_IP=
PANEL_PEOPLE=
# Wi-Fi devices card: tplink reads every connected device from a TP-Link router
PANEL_ROUTER=
# names for devices that report none, by MAC: F4-70-18-00-00-01=Doorbell,02-52-5B-00-00-02=Server
PANEL_DEVICE_NAMES=
# devices to leave out of the panel, by MAC, comma-separated (e.g. a camera's Wi-Fi you turned off
# because it's on cable: otherwise it shows as an offline camera for a month)
PANEL_DEVICE_HIDE=
# Speed test card: how many tests a day, 0 to 6 (0 = only the "Test now" button). Each test
# moves ~100 MB through your internet, so mind data caps. Empty = no speed test.
PANEL_SPEEDTEST=
# Router admin page and password, only for PANEL_ROUTER=tplink (usually http://192.168.1.1)
ROUTER_URL=
ROUTER_PASSWORD=

# --- Step 9, photo backup (optional) --------------------------------------------------------------
# Password for the Syncthing control page, user "admin".
# Leave it empty and the script makes one up and adds it at the end of this file.
SYNCTHING_GUI_PASSWORD=

# --- Step 10, smart plug that charges between 30 and 80% (optional) ------------------------------
# From your iot.tuya.com cloud project (scripts/10-smart-plug.sh explains how to make one):
# Access ID, Access Secret and data center (us = Western America, eu, in, cn).
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=
# only if Smart Life has more than one device: the plug's name there
TUYA_PLUG_NAME=
# Charge window in %, default 30 and 80 (low at least 10, at least 10 apart).
# The panel does the switching: change these, then re-run step 8.
CHARGE_LOW=
CHARGE_HIGH=

# --- Step 11, cameras in the panel, home only (optional) -----------------------------------------
# One entry per camera, Name=IP:CODE, comma separated. Give each camera a fixed IP in the router.
# Ezviz / Hikvision: the code is the verification code on the camera's sticker.
#   PANEL_CAMERAS="Front=192.168.1.50:ABCDEF,Back=192.168.1.52:GHIJKL"
PANEL_CAMERAS=
# Other brands: RTSP user and paths (defaults: admin, /ch1/main/av_stream, /ch1/sub/av_stream).
CAMERA_USER=
CAMERA_MAIN_PATH=
CAMERA_SUB_PATH=
